# Separate image for the downloader: ffmpeg + yt-dlp are large and update on a
# different cadence to the web app. Keeping them apart means a yt-dlp bump
# doesn't rebuild or restart the web container.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
COPY youtube_subs_opml/ ./youtube_subs_opml/

RUN uv pip install --system --no-cache ".[downloader]"

# yt-dlp is pinned via the "downloader" extra above. YouTube breaks extraction
# every few months; when that happens, bump the pin (or just rebuild this image)
# to pick up a fresh yt-dlp release.
CMD ["python", "-m", "youtube_subs_opml.downloader.worker"]
